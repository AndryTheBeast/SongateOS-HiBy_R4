# Firmware and personal backups never go in this repo
*.bin
*.img
!device/hiby/R4/prebuilt/dtb.img
!device/hiby/R4/prebuilt/dtbo.img
*.zip
# public release certificate for the recoveries (the update signature check); generated by ota/make_release_key.sh
!device/hiby/R4/recovery/root/system/etc/security/songateos_otacerts.zip
*.elf
*.mbn
dumps/
backup/
SHA256SUMS.txt

# build / generator output
out/
*_out/
__pycache__/
*.pyc

# system/: built and patched binaries are made on your own machine/device, never committed
*.so
*.apk
*.dex
system/keys/

# private keys never go in this repo (the SongateOS release key lives offline)
*.pk8
*.p12
*.jks
*.keystore
*.key
*private*
