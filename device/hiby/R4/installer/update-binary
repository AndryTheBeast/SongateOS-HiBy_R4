#!/sbin/sh
# TWRP installer for the HiBy R4 (standard model). Flash it from TWRP or OrangeFox to switch recoveries.
# Writes recovery_a and recovery_b, like the OrangeFox zip, so both slots hold the same recovery. Checks the device
# and the image before writing, and reads each partition back afterwards. Nothing else on the player is touched
# (the active slot isn't changed).
OUTFD=$2
ZIP=$3
IMG=/tmp/twrp_r4_recovery.img
PART=/dev/block/by-name/recovery_a
PART_B=/dev/block/by-name/recovery_b

# the recovery's mksh can't redirect to a two-digit fd (">&50"), so write through /proc
ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
abort() { ui_print "Error: $1"; ui_print "Nothing was written."; rm -f "$IMG"; exit 1; }

ui_print "TWRP 3.7 for the HiBy R4"
ui_print "-------------------------"

# 1. the right player: HiBy R4 standard model (Qualcomm trinket, eMMC). The R4 EVA uses UFS storage.
dev=$(getprop ro.product.device)
vdev=$(getprop ro.product.vendor.device)
plat=$(getprop ro.board.platform)
case "$dev$vdev" in *R4*) ;; *) abort "this isn't a HiBy R4 (device: ${dev:-unknown})";; esac
[ "$plat" = trinket ] || abort "unexpected platform (${plat:-unknown}), not a standard R4"
[ -b "$PART" ] || abort "recovery_a partition not found"
[ -b "$PART_B" ] || abort "recovery_b partition not found"
case "$(readlink -f "$PART")" in
  /dev/block/mmcblk0*) ;;
  *) abort "recovery_a isn't on eMMC storage: this looks like an R4 EVA, which isn't supported";;
esac

# 2. the image: unpacked intact, a boot-format image, exactly the partition's size
unzip -o -p "$ZIP" recovery.img > "$IMG" || abort "couldn't unpack the image"
want=$(unzip -o -p "$ZIP" recovery.img.sha256 | cut -d' ' -f1)
have=$(sha256sum "$IMG" | cut -d' ' -f1)
[ -n "$want" ] && [ "$have" = "$want" ] || abort "the image in the zip is damaged (checksum mismatch)"
[ "$(head -c 8 "$IMG")" = "ANDROID!" ] || abort "the image isn't a recovery image"
isz=$(wc -c < "$IMG")
psz=$(blockdev --getsize64 "$PART")
[ "$isz" = "$psz" ] || abort "size mismatch (image $isz, partition $psz)"
[ "$(blockdev --getsize64 "$PART_B")" = "$psz" ] || abort "recovery_b has a different size"

# 3. write recovery_a, then recovery_b, reading each back
fail=0
for P in "$PART" "$PART_B"; do
  n=${P##*/}
  ui_print "Writing $n ..."
  dd if="$IMG" of="$P" bs=1048576 2>/dev/null || { ui_print "Error: writing $n failed"; fail=1; continue; }
  sync
  if [ "$(sha256sum "$P" | cut -d' ' -f1)" = "$want" ]; then
    ui_print "  $n checked"
  else
    ui_print "Error: $n doesn't read back the same"
    fail=1
  fi
done
rm -f "$IMG"
if [ $fail = 1 ]; then
  ui_print "Flash this zip again, or put your own recovery back (guide 2)."
  exit 1
fi
ui_print "Done: TWRP is in recovery_a and recovery_b."
ui_print "Reboot to recovery to start it."
exit 0
