# HiBy R4 (standard) recovery fstab - based on stock fstab.default / recovery.fstab
#<src>                                      <mnt_point>     <type>  <mnt_flags and options>                                   <fs_mgr_flags>

# Logical partitions in super (slot a only exists on this unit)
system                                      /system         ext4    ro,barrier=1,discard                                      wait,slotselect,logical,first_stage_mount
system_ext                                  /system_ext     ext4    ro,barrier=1,discard                                      wait,slotselect,logical,first_stage_mount
product                                     /product        ext4    ro,barrier=1,discard                                      wait,slotselect,logical,first_stage_mount
vendor                                      /vendor         ext4    ro,barrier=1,discard                                      wait,slotselect,logical,first_stage_mount

/dev/block/bootdevice/by-name/metadata      /metadata       ext4    noatime,nosuid,nodev,discard                              wait,check,formattable,first_stage_mount
/dev/block/bootdevice/by-name/userdata      /data           f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt    latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,checkpoint=fs

# Raw partitions (slot-suffixed)
/dev/block/bootdevice/by-name/boot          /boot           emmc    defaults                                                  slotselect
/dev/block/bootdevice/by-name/recovery      /recovery       emmc    defaults                                                  slotselect
/dev/block/bootdevice/by-name/dtbo          /dtbo           emmc    defaults                                                  slotselect
/dev/block/bootdevice/by-name/vbmeta        /vbmeta         emmc    defaults                                                  slotselect
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system  emmc    defaults                                                  slotselect
/dev/block/bootdevice/by-name/misc          /misc           emmc    defaults                                                  defaults

# Removable storage is defined only in twrp.flags (block devices /dev/block/mmcblk1p1, sdg1).
# Do not add sysfs "voldmanaged" entries here: TWRP merges them with twrp.flags and MicroSD then shows 0 MB.
