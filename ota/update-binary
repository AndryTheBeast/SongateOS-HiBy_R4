#!/system/bin/sh
# SongateOS update installer for the HiBy R4 (standard model), run by TWRP / OrangeFox.
#   update-binary <api> <outfd> <zip>
#
# What it may write, and nothing else:
# The ACTIVE slot (a or b; 2.2, 2026-11-22: HiBy's own updates leave an R4 on either slot) - its:
#   - system_<slot>   (logical partition in super; grown with lptools only if the new image is larger)
#   - imagefv_<slot>  (boot logo) only if the zip has a logo patch AND the R4 shows exactly HiBy's stock logo or a
#                SongateOS logo the patch knows (sha256 before, and the patched result checked before writing)
#   - /metadata/songateos/ota.result and recovery.info (small text files for the updater)
# Never: slot b, boot/dtbo/vbmeta, recovery, xbl, tz, rpm, hyp, abl, devcfg, keymaster, persist, modemst1/2,
# fsg, devinfo, frp, privdata1/2, the GPT, or userdata (your apps, settings and Magisk stay as they are).
#
# All checks run before the first write. A zip built with "kind=test" runs only the checks (dry run).
OUTFD=$2
ZIP=$3
TMP=/tmp/songateos_ota
# the slot the player runs on; every write goes to that slot's partitions (the other slot is never touched)
SLOT=$(getprop ro.boot.slot_suffix)
SYS_DEV=/dev/block/mapper/system$SLOT
FV_DEV=/dev/block/bootdevice/by-name/imagefv$SLOT
VBMETA_DEV=/dev/block/bootdevice/by-name/vbmeta$SLOT
META_MNT=""; META_OWN=0; VEND_OWN=0

TRACE=/tmp/songateos_install.log
ui_print() { echo "ui_print $*" >> /proc/self/fd/$OUTFD; echo "ui_print" >> /proc/self/fd/$OUTFD; trace "UI: $*"; }
trace() { echo "$(date +%T) $*" >> $TRACE; }

# A writable /metadata: the recovery may already have it mounted (possibly read-only), so test by writing.
meta_ok() { touch "$1/.sgos_w" 2>>$TRACE && rm -f "$1/.sgos_w"; }
meta_mount() {
  [ -n "$META_MNT" ] && return 0
  if mountpoint -q /metadata 2>/dev/null; then
    if meta_ok /metadata; then META_MNT=/metadata; trace "metadata: /metadata writable"; return 0; fi
    trace "metadata: /metadata read-only ($(grep ' /metadata ' /proc/mounts)), remounting rw"
    if mount -o remount,rw /metadata 2>>$TRACE && meta_ok /metadata; then META_MNT=/metadata; return 0; fi
  fi
  mkdir -p $TMP/meta
  if mount -t ext4 -o rw,noatime /dev/block/bootdevice/by-name/metadata $TMP/meta 2>>$TRACE && meta_ok $TMP/meta; then
    META_MNT=$TMP/meta; META_OWN=1; trace "metadata: own mount at $TMP/meta"; return 0
  fi
  trace "metadata: NOT writable"
  return 1
}

result() {  # $1 status, $2 detail
  trace "result $1: $2"
  { echo "status=$1"; echo "detail=$2"; echo "version=$VERSION"; echo "time=$(date +%s)"; } > $TMP/ota.result
  if meta_mount; then
    mkdir -p "$META_MNT/songateos"
    cp -f $TMP/ota.result "$META_MNT/songateos/ota.result.tmp" && \
      mv -f "$META_MNT/songateos/ota.result.tmp" "$META_MNT/songateos/ota.result" || trace "metadata: result write failed"
  fi
  save_logs
  sync
}

# The recovery's record for the updater (2.1.0 re-release, 2026-11-21): the recovery's hook writes
# /metadata/songateos/recovery.info at every recovery start, but Format Data wipes /metadata, so after a fresh install
# Android saw no record and refused the first update ("Restart into recovery once"). The installer runs inside that
# same recovery, so it writes the same record here, the way the hook does (name, hook version, slot, sha256 of the
# recovery partition). Only when this recovery has the hook (its own /system/bin/runatboot.sh says HOOK_VERSION).
record_recovery() {
  hookv=$(grep -m1 '^HOOK_VERSION=' /system/bin/runatboot.sh 2>/dev/null | cut -d= -f2)
  echo "$hookv" | grep -qE '^[0-9]+$' || { trace "recovery record: this recovery has no SongateOS hook, not written"; return; }
  meta_mount || { trace "recovery record: /metadata not writable"; return; }
  slot=$(getprop ro.boot.slot_suffix)
  name=TWRP; { [ -n "$(getprop ro.build.fox_id)$(getprop ro.orangefox.version)" ] || [ -d /FFiles ]; } && name=OrangeFox
  rsha=$(sha256sum /dev/block/bootdevice/by-name/recovery$slot 2>/dev/null | cut -d' ' -f1)
  [ -n "$rsha" ] || { trace "recovery record: recovery$slot unreadable"; return; }
  mkdir -p "$META_MNT/songateos"
  { echo "name=$name"; echo "hook=$hookv"; echo "slot=$slot"; echo "sha256=$rsha"
    echo "twrp=$(getprop ro.twrp.version)"; echo "time=$(date +%s)"; echo "source=installer"; } > "$META_MNT/songateos/recovery.info.tmp" && \
    mv -f "$META_MNT/songateos/recovery.info.tmp" "$META_MNT/songateos/recovery.info" && \
    trace "recovery record: $name hook $hookv slot $slot" || trace "recovery record: write failed"
}

# Keep this install's trace and the end of the recovery log (small text files): in /metadata/songateos for the
# updater, and next to the zip on the microSD as a fallback the user (or Android) can always read.
save_logs() {
  if [ -n "$META_MNT" ]; then
    cp -f $TRACE "$META_MNT/songateos/install.log" 2>/dev/null
    tail -n 300 /tmp/recovery.log > "$META_MNT/songateos/recovery_tail.log" 2>/dev/null
  fi
  SDD=$(dirname "$ZIP")
  if [ -d "$SDD" ]; then
    cp -f $TRACE "$SDD/songateos_install.log" 2>/dev/null
    cp -f $TMP/ota.result "$SDD/songateos_ota.result" 2>/dev/null
    tail -n 400 /tmp/recovery.log > "$SDD/songateos_recovery_tail.log" 2>/dev/null
  fi
}

cleanup() {
  [ "$VEND_OWN" = 1 ] && umount $TMP/vendor 2>/dev/null
  [ "$META_OWN" = 1 ] && umount $TMP/meta 2>/dev/null
}

abort() {
  ui_print "ERROR: $1"
  ui_print "Nothing was written."
  result fail "$1"
  cleanup
  exit 1
}

# only these two block devices may ever be written by this script
write_ok() {
  case "$1" in "$SYS_DEV"|"$FV_DEV") return 0 ;; esac
  return 1
}

prop() { grep "^$1=" $TMP/ota.prop | head -n1 | cut -d= -f2-; }

rm -rf $TMP; mkdir -p $TMP
: > $TRACE
trace "update-binary start: api=$1 outfd=$2 zip=$3 uid=$(id -u) shell=$(readlink /proc/$$/exe)"
trace "mounts: $(grep -E ' /metadata | /external_sd ' /proc/mounts | tr '\n' ';')"
trace "selinux: $(getenforce 2>&1) ctx: $(cat /proc/self/attr/current 2>/dev/null)"
trace "unzip: $(command -v unzip) device=$(getprop ro.product.device)"
result running "installer started"
ui_print " "
ui_print "SongateOS for the HiBy R4"
unzip -p "$ZIP" songateos/ota.prop > $TMP/ota.prop 2>>$TRACE
trace "ota.prop: $(tr '\n' ';' < $TMP/ota.prop)"
[ -s $TMP/ota.prop ] || abort "not a SongateOS update zip (no songateos/ota.prop)"
VERSION=$(prop version); KIND=$(prop kind)
SYS_SIZE=$(prop system_size); SYS_SHA=$(prop system_sha256)
SYS_PARTS=$(prop system_parts); SYS_PART_SIZE=$(prop system_part_size)   # pieces (2026-11-19); empty = one system.img
FV_SHA=$(prop imagefv_sha256); FV_FROM=$(prop imagefv_from); FV_MAP=$(prop imagefv_map); FV_WANT=$(prop imagefv_size)
ui_print "Version $VERSION ($KIND)"
[ "$(prop device)" = "R4" ] || abort "zip is not for the HiBy R4"

# ---------------- checks (read only) ----------------
ui_print "Checking the device..."
# our recovery for the standard R4
[ "$(getprop ro.product.device)" = "R4" ] || abort "this recovery is not for the HiBy R4"
# device tree from HiBy's boot image: exact standard-R4 model (the R4 EVA and other models fail here)
DTMODEL=$(tr -d '\000' < /proc/device-tree/model 2>/dev/null)
case "$DTMODEL" in
  *"HiBy R4") ;;
  *) abort "device tree model '$DTMODEL' is not the standard HiBy R4" ;;
esac
tr '\000' ' ' < /proc/device-tree/compatible 2>/dev/null | grep -q "qcom,trinket" || abort "not an SM6125 (trinket)"
case "$DTMODEL" in *EVA*|*eva*) abort "R4 EVA is not supported" ;; esac
# HiBy's own vendor partition for the standard R4 must be in place (SongateOS runs on it)
mkdir -p $TMP/vendor
if mount -t ext4 -o ro /dev/block/mapper/vendor$SLOT $TMP/vendor 2>/dev/null; then
  VEND_OWN=1
  VFP=$(grep -h '^ro.vendor.build.fingerprint=' $TMP/vendor/build.prop 2>/dev/null | cut -d= -f2-)
  VMODEL=$(grep -h '^ro.product.vendor.model=' $TMP/vendor/build.prop 2>/dev/null | cut -d= -f2-)
  umount $TMP/vendor; VEND_OWN=0
else
  abort "cannot read the vendor partition"
fi
case "$VFP" in HiBy/R4/R4:*) ;; *) abort "vendor is not HiBy's R4 vendor ($VFP)" ;; esac
[ "$VMODEL" = "R4" ] || abort "vendor model '$VMODEL' is not R4"
# the active slot, a or b (the device checks above ran on it)
case "$SLOT" in _a|_b) ;; *) abort "unknown active slot '$SLOT'" ;; esac
# verified boot must already be off for this slot (vbmeta flags 3), otherwise the new system won't boot
VBF=$(dd if=$VBMETA_DEV bs=1 skip=120 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
VBM=$(dd if=$VBMETA_DEV bs=1 count=4 2>/dev/null)
[ "$VBM" = "AVB0" ] || abort "vbmeta$SLOT has no AVB header"
case "$VBF" in 00000003) ;; *) abort "vbmeta$SLOT flags are $VBF, need 00000003 (see docs/03-install-os.md)" ;; esac
[ -b "$SYS_DEV" ] || abort "system$SLOT is not mapped ($SYS_DEV)"
ui_print "  HiBy R4, slot ${SLOT#_}, vbmeta flags 3: OK"

# Sizes go past 2 GB: some recoveries' shells (OrangeFox's) do 32-bit arithmetic and get them wrong (0.1.0-beta.8
# on OrangeFox: system_a wasn't grown and a piece's position went negative). All large-number work goes to awk.
gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 > b + 0) }'; }   # $1 > $2
kb() { awk -v a="$1" -v b="${2:-0}" 'BEGIN { printf "%d", a / 1024 + b }'; }   # bytes -> kB, plus $2 kB

# system image in the zip
if [ "$KIND" != "test" ]; then
  echo "$SYS_SIZE" | grep -qE '^[0-9]+$' || abort "bad system_size in ota.prop"
  echo "$SYS_SHA" | grep -qE '^[0-9a-f]{64}$' || abort "bad system_sha256 in ota.prop"
  if [ -n "$SYS_PARTS" ]; then
    echo "$SYS_PARTS$SYS_PART_SIZE" | grep -qE '^[0-9]+$' || abort "bad system_parts in ota.prop"
    [ $(( (SYS_PART_SIZE % 4194304) )) = 0 ] || abort "bad system_part_size in ota.prop"
    n=$(unzip -l "$ZIP" 2>/dev/null | grep -cE 'system\.img\.[0-9][0-9]$')
    [ "$n" = "$SYS_PARTS" ] || abort "zip has $n of $SYS_PARTS system image pieces"
  else
    unzip -l "$ZIP" system.img 2>/dev/null | grep -q system.img || abort "zip has no system.img"
  fi
  CUR=$(blockdev --getsize64 $SYS_DEV)
  if gt "$SYS_SIZE" "$CUR"; then
    command -v lptools >/dev/null 2>&1 || abort "new system ($SYS_SIZE) is larger than system$SLOT ($CUR) and this recovery has no lptools"
    NEED_RESIZE=1
  fi
fi

# boot logo (read only here): the patch is applied to a copy in RAM; only an exact result is written later.
# HiBy's signed logo container is never in the zip, only SongateOS's own bytes (imagefv.patch + imagefv_map).
FV_ACTION=none
if [ -n "$FV_SHA" ]; then
  HAVE_FV=$(sha256sum $FV_DEV 2>>$TRACE | cut -d' ' -f1)
  FV_SIZE=$(blockdev --getsize64 $FV_DEV 2>>$TRACE)
  trace "imagefv: have $HAVE_FV size $FV_SIZE, want $FV_SHA"
  if [ "$HAVE_FV" = "$FV_SHA" ]; then
    FV_ACTION=same
  elif [ "$FV_SIZE" != "$FV_WANT" ] || ! echo ",$FV_FROM," | grep -q ",$HAVE_FV,"; then
    FV_ACTION=unknown
  else
    unzip -p "$ZIP" imagefv.patch > $TMP/imagefv.patch 2>>$TRACE
    dd if=$FV_DEV of=$TMP/imagefv.img bs=1048576 2>>$TRACE
    pos=0; ok=1
    for r in $(echo "$FV_MAP" | tr ',' ' '); do
      off=${r%%:*}; len=${r##*:}
      dd if=$TMP/imagefv.patch of=$TMP/imagefv.img bs=1 skip=$pos seek=$off count=$len conv=notrunc 2>>$TRACE || ok=0
      pos=$((pos + len))   # small numbers (the logo is 2 MB): safe in the recovery's 32-bit shell arithmetic
    done
    [ "$pos" = "$(stat -c %s $TMP/imagefv.patch)" ] || ok=0
    if [ "$ok" = 1 ] && [ "$(sha256sum $TMP/imagefv.img | cut -d' ' -f1)" = "$FV_SHA" ]; then
      FV_ACTION=write
    else
      FV_ACTION=bad
    fi
    rm -f $TMP/imagefv.patch
  fi
  trace "imagefv: $FV_ACTION"
fi

if [ "$KIND" = "test" ]; then
  ui_print "Test zip: all checks passed, nothing written."
  result test_ok "checks passed"
  cleanup
  exit 0
fi

# ---------------- write ----------------
umount /system_root 2>/dev/null; umount /system 2>/dev/null; umount /mnt/system 2>/dev/null
# OrangeFox mounts system_a on /apex when HiBy's stock system is installed; that keeps system_a busy and it can't be
# mapped again at its new size (first install from stock, 2026-11-19). Let go of every mount of the system partition.
for m in $(grep -E "^($SYS_DEV|$(readlink -f $SYS_DEV)) " /proc/mounts | cut -d' ' -f2); do umount "$m" 2>/dev/null; done
if [ "$NEED_RESIZE" = 1 ]; then
  ui_print "Growing system$SLOT to $SYS_SIZE bytes..."
  if ! lptools resize system$SLOT "$SYS_SIZE"; then
    # Coming from HiBy's firmware, super still holds its unused update leftovers (the "-cow" partitions, ~1.9 GB on
    # the R4; first install from stock 2026-11-19). They only matter while an Android update is being merged, and
    # recovery can't be in the middle of one, unless the update state says so: then stop and touch nothing.
    [ -e /metadata/ota/snapshot-boot ] && abort "super has no free space and an Android update is still being merged; start Android once, then try again"
    COWS=""
    for p in system_a-cow vendor_a-cow system_ext_a-cow product_a-cow odm_a-cow system_b-cow vendor_b-cow system_ext_b-cow product_b-cow odm_b-cow; do
      [ -e /dev/block/mapper/$p ] && COWS="$COWS $p" && continue
      lptools map $p >/dev/null 2>&1 && COWS="$COWS $p"
    done
    [ -n "$COWS" ] || abort "lptools could not grow system$SLOT (not enough free space in super)"
    # super's table (its first 1 MiB) next to the zip first, so the removal can be undone
    SUPER=/dev/block/by-name/super
    dd if=$SUPER of="$(dirname "$ZIP")/super_table_before_songateos.bin" bs=1048576 count=1 2>/dev/null       && trace "super table saved next to the zip"
    ui_print "Freeing space in super: removing HiBy's unused update leftovers ($COWS )..."
    for p in $COWS; do
      lptools unmap $p >/dev/null 2>&1
      r=$(lptools remove $p 2>&1 | tail -1); trace "remove $p: $r"
    done
    lptools resize system$SLOT "$SYS_SIZE" || abort "lptools could not grow system$SLOT (not enough free space in super?)"
  fi
  # the recovery mapped system_a at its start; resize only changes super's table, so map it again at the new size
  # (0.1.0-beta.4: the old mapping kept the old size and the install stopped here)
  lptools unmap system$SLOT >/dev/null 2>&1
  lptools map system$SLOT >/dev/null 2>&1
  [ -b "$SYS_DEV" ] || lptools map system$SLOT
  NEW=$(blockdev --getsize64 $SYS_DEV)
  gt "$SYS_SIZE" "$NEW" && abort "system$SLOT is still too small ($NEW)"
fi
write_ok "$SYS_DEV" || abort "internal: refusing to write $SYS_DEV"
blockdev --setrw $SYS_DEV 2>/dev/null
ui_print "Writing system$SLOT (this takes a few minutes)..."
result writing "system$SLOT"
# The recoveries' unzip (Android's ziptool) holds the whole entry in RAM when it writes to a pipe: an image larger
# than the free RAM aborted with nothing written (0.1.0-beta.4, 2.97 GB image, 2.6 GB RAM). Then extract it to the
# microSD next to the zip first (a file is written in pieces), check it, write it from there and delete it.
AVAIL_KB=$(sed -n 's/^MemAvailable: *\([0-9]*\) kB/\1/p' /proc/meminfo)
# without pieces: the partition must be big enough before anything is written
gt "$SYS_SIZE" "$(blockdev --getsize64 $SYS_DEV)" && abort "system$SLOT is smaller than the new system (nothing was written)"
if [ -n "$SYS_PARTS" ]; then
  # pieces of 512 MB, each fits in RAM: written straight from the zip, no microSD needed (adb sideload works too)
  : > $TMP/dd.log
  i=0
  while [ $i -lt "$SYS_PARTS" ]; do
    p=$(printf "%02d" $i)
    ui_print "  piece $((i + 1)) of $SYS_PARTS"
    # the position in 4 MB blocks (128 per 512 MB piece): small numbers, right in any shell
    unzip -p "$ZIP" system.img.$p | dd of=$SYS_DEV bs=4194304 seek=$((i * (SYS_PART_SIZE / 4194304))) conv=notrunc 2>>$TMP/dd.log
    i=$((i + 1))
  done
  sync
elif gt "$(kb "$SYS_SIZE" 262144)" "$AVAIL_KB"; then
  XDIR="$(dirname "$ZIP")/.songateos_tmp"
  FREE_KB=$(df -k "$(dirname "$ZIP")" | tail -1 | awk '{print $4}')
  gt "$FREE_KB" "$(kb "$SYS_SIZE" 102400)" || abort "not enough space on the microSD to unpack the update ($(kb "$SYS_SIZE") kB needed)"
  ui_print "  unpacking to the microSD first (the image is larger than the free memory)..."
  rm -rf "$XDIR"; mkdir -p "$XDIR" || abort "cannot write to the microSD"
  ( cd "$XDIR" && unzip -o "$ZIP" system.img >/dev/null 2>$TMP/unzip.log ) || { rm -rf "$XDIR"; abort "could not unpack the update to the microSD"; }
  [ "$(sha256sum "$XDIR/system.img" | cut -d' ' -f1)" = "$SYS_SHA" ] || { rm -rf "$XDIR"; abort "the unpacked image does not match the update (nothing was written)"; }
  dd if="$XDIR/system.img" of=$SYS_DEV bs=4194304 2>$TMP/dd.log
  sync
  rm -rf "$XDIR"
else
  unzip -p "$ZIP" system.img | dd of=$SYS_DEV bs=4194304 2>$TMP/dd.log
  sync
fi
ui_print "Checking what was written..."
GOT=$(head -c "$SYS_SIZE" $SYS_DEV | sha256sum | cut -d' ' -f1)
if [ "$GOT" != "$SYS_SHA" ]; then
  ui_print "ERROR: system$SLOT does not match the update after writing."
  ui_print "dd: $(tail -n2 $TMP/dd.log)"
  ui_print "Install the zip again, or restore your system backup (docs/03-install-os.md)."
  result fail "system$SLOT verify failed"
  cleanup
  exit 1
fi
ui_print "  system$SLOT OK"

# boot logo: written only when the patched copy was exactly the SongateOS logo (FV_ACTION=write, checked above)
case "$FV_ACTION" in
  same) ui_print "Boot logo already up to date" ;;
  write)
    write_ok "$FV_DEV" || abort "internal: refusing to write $FV_DEV"
    ui_print "Writing the SongateOS boot logo (imagefv$SLOT)..."
    dd if=$TMP/imagefv.img of=$FV_DEV bs=1048576 2>>$TRACE; sync
    if [ "$(sha256sum $FV_DEV | cut -d' ' -f1)" = "$FV_SHA" ]; then
      ui_print "  boot logo OK"
    else
      ui_print "WARNING: boot logo check failed: restore imagefv$SLOT from your backup (docs/01)"
      trace "imagefv: read-back mismatch"
    fi ;;
  unknown) ui_print "Boot logo left as it is (not HiBy's stock logo or a SongateOS logo this zip knows)" ;;
  bad) ui_print "Boot logo left as it is (the patched logo did not check out)" ;;
esac
rm -f $TMP/imagefv.img

record_recovery

result ok "installed"
ui_print "SongateOS $VERSION installed."
cleanup
exit 0
