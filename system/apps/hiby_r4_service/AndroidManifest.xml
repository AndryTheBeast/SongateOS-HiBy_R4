<?xml version="1.0" encoding="utf-8"?>
<!-- HiBy R4 service: system app (platform key, system uid). Holds the equalizer, offers the settings API for other
     apps (authority com.andre.hibyr4.settings, permission HIBY_SETTINGS) and the Settings entries. No launcher icon. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.andre.hibyr4.service"
    android:sharedUserId="android.uid.system">

    <permission android:name="com.andre.hibyr4.permission.HIBY_SETTINGS"
        android:label="@string/perm_label"
        android:description="@string/perm_desc"
        android:protectionLevel="normal" />

    <!-- SongateOS system API (SystemApi.java, SYSTEM_API.md): only for Songate (its certificates) and platform apps -->
    <permission android:name="com.andre.hibyr4.permission.SYSTEM_SETTINGS"
        android:label="@string/sys_perm_label"
        android:description="@string/sys_perm_desc"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/songate_certs" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- system API: Wi-Fi, Bluetooth, audio output (all held by the system uid; listed for clarity) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- SongateOS updates (Updater): GitHub release check/download, notification, reboot to recovery -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.RECOVERY" />
    <!-- SongateOS system colours (SystemTheme): the palette overlay, Android's colour setting, dark / light -->
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <!-- hold switch: power + volume-down device off while locked, sleep / wake on the switch -->
    <uses-permission android:name="android.permission.DISABLE_INPUT_DEVICE" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_hiby_audio"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:persistent="true"
        android:directBootAware="true"
        android:allowBackup="false"
        android:name="com.andre.hibyr4sound.App">

        <provider android:name="com.andre.hibyr4sound.HiBySettingsProvider"
            android:authorities="com.andre.hibyr4.settings"
            android:exported="true"
            android:readPermission="com.andre.hibyr4.permission.HIBY_SETTINGS"
            android:writePermission="com.andre.hibyr4.permission.HIBY_SETTINGS" />

        <activity android:name="com.andre.hibyr4sound.MainActivity" android:exported="true" android:noHistory="true"
            android:permission="com.andre.hibyr4.permission.HIBY_SETTINGS"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.andre.hibyr4.action.OPEN_AUDIO_SETTINGS" />
                <action android:name="com.andre.hibyr4.action.OPEN_LED_SETTINGS" />
                <action android:name="com.andre.hibyr4.action.OPEN_EQ_SETTINGS" />
                <action android:name="com.andre.hibyr4.action.OPEN_UPDATE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings home page entry; Settings opens its own page (FRAGMENT_CLASS) instead of this activity -->
        <activity-alias android:name="com.andre.hibyr4sound.SettingsHomeTile" android:targetActivity="com.andre.hibyr4sound.MainActivity"
            android:exported="true" android:label="@string/tile_title"
            android:icon="@drawable/ic_hiby_audio">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.homepage" />
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS" android:value="com.andre.hibyr4.settings.HiByAudioSettings" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/tile_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/tile_summary" />
            <meta-data android:name="com.android.settings.icon" android:resource="@drawable/ic_hiby_audio" />
            <meta-data android:name="com.android.settings.order" android:value="-150" />
        </activity-alias>

        <activity-alias android:name="com.andre.hibyr4sound.SettingsSoundTile" android:targetActivity="com.andre.hibyr4sound.MainActivity"
            android:exported="true" android:label="@string/tile_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.sound" />
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS" android:value="com.andre.hibyr4.settings.HiByAudioSettings" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/tile_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/tile_summary" />
        </activity-alias>

        <activity-alias android:name="com.andre.hibyr4sound.SettingsLedTile" android:targetActivity="com.andre.hibyr4sound.MainActivity"
            android:exported="true" android:label="@string/led_tile_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.display" />
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS" android:value="com.andre.hibyr4.settings.HiByLedSettings" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/led_tile_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/led_tile_summary" />
        </activity-alias>

        <!-- Settings > System > SongateOS update -->
        <activity-alias android:name="com.andre.hibyr4sound.SettingsUpdateTile" android:targetActivity="com.andre.hibyr4sound.MainActivity"
            android:exported="true" android:label="@string/update_tile_title"
            android:icon="@drawable/ic_songateos_update">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.system" />
            <meta-data android:name="com.android.settings.icon" android:resource="@drawable/ic_songateos_update" />
            <meta-data android:name="com.android.settings.FRAGMENT_CLASS" android:value="com.andre.hibyr4.settings.HiBySystemUpdate" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/update_tile_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/update_tile_summary" />
            <meta-data android:name="com.android.settings.order" android:value="-200" />
        </activity-alias>

        <!-- daily SongateOS update check on Wi-Fi (Updater.schedule) -->
        <service android:name="com.andre.hibyr4sound.UpdateJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 3.5 mm line out sync, sent only by the module (root, explicit component); not reachable by apps -->
        <receiver android:name="com.andre.hibyr4sound.LineOut" android:exported="false" />

        <!-- LED refresh after an LED setting change, sent only by the module (root, explicit component) -->
        <receiver android:name="com.andre.hibyr4sound.Lights" android:exported="false" />

        <!-- wired DAC volume refresh (boot settings, balance, audio HAL restart), sent only by the module -->
        <receiver android:name="com.andre.hibyr4sound.DacVolume" android:exported="false" />

        <!-- notification light (colour LED / back light); access is granted only while an option needs it -->
        <service android:name="com.andre.hibyr4sound.LightsNotif" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name="com.andre.hibyr4sound.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
