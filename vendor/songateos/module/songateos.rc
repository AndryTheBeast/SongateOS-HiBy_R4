# SongateOS (HiBy R4): the jobs the Magisk module did, as init services. The scripts run as root in TrebleDroid's
# phhsu_daemon domain (the same one its own boot scripts use); their files are labelled phhsu_exec.

# Audio policy + HiBy's audio HAL (patched from the player's own file), volume steps, key layout: before the audio
# HAL, audioserver and system_server start.
on post-fs-data
    exec u:r:phhsu_daemon:s0 root root -- /system_ext/bin/songateos/post-fs-data.sh

# Settings bridge, LEDs, outputs, line out, updates hand-off, hold switch: the rest of the boot and the main loop.
service songateos /system_ext/bin/songateos/service.sh
    class late_start
    user root
    group root
    seclabel u:r:phhsu_daemon:s0

