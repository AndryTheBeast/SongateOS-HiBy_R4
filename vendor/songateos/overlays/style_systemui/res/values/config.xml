<?xml version="1.0" encoding="utf-8"?>
<!-- Default quick-settings tiles for a music player (used for new users / "reset tiles"; an existing tile setup keeps
     the user's own): Wi-Fi/internet, Bluetooth, do not disturb, battery saver, dark theme, auto-rotate, airplane mode
     (offline listening). Left out: flashlight, cast, alarm, wallet, controls, screen record, camera/mic toggles,
     safety center.
     SystemUI needs at least quick_settings_min_num_tiles (6) tiles that it can create: with fewer it prepends this
     default list again and again (SongateOS 0.1.0-beta.1: the setting grew to its 32768-character limit and SystemUI
     crashed in a loop). Seven here, so one unavailable tile still leaves six. -->
<resources>
    <string name="quick_settings_tiles_default" translatable="false">internet,bt,dnd,battery,dark,rotation,airplane</string>
</resources>
